<?xml version="1.0" encoding="utf-8"?>
<!-- Allow cleartext ws:// to any daemon host (loopback Magisk/bring-up, LAN Pi,
     etc.). The daemon speaks plain ws:// on port 2026 and may live on any host,
     so cleartext is permitted globally rather than per-domain. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
